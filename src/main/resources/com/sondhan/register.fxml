<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>

<StackPane xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.sondhan.controller.RegisterController"
           styleClass="root-pane">

    <VBox styleClass="auth-card" maxWidth="440.0" alignment="CENTER" spacing="20.0">
        <padding><Insets top="42" right="48" bottom="42" left="48"/></padding>

        <!-- Brand Title -->
        <VBox alignment="CENTER" spacing="6.0">
            <Label text="Sondhan" styleClass="brand-logo-large"/>
            <Label text="Create Account" styleClass="brand-subtitle-large"/>
            <Label text="Your fact-checking history is stored securely on your device"
                   styleClass="text-muted" textAlignment="CENTER" wrapText="true"/>
        </VBox>

        <!-- Error Notification -->
        <Label fx:id="errorLabel" styleClass="error-label" wrapText="true" maxWidth="350.0"
               visible="false" managed="false"/>

        <!-- Form Inputs -->
        <VBox spacing="14.0" maxWidth="Infinity">
            <VBox spacing="5.0">
                <Label text="Full Name" styleClass="field-label"/>
                <TextField fx:id="nameField" promptText="Your Name" styleClass="input-field"/>
            </VBox>

            <VBox spacing="5.0">
                <Label text="Email Address" styleClass="field-label"/>
                <TextField fx:id="emailField" promptText="name@example.com" styleClass="input-field"/>
            </VBox>

            <VBox spacing="5.0">
                <Label text="Password" styleClass="field-label"/>
                <PasswordField fx:id="passwordField" promptText="Minimum 6 characters" styleClass="input-field"/>
            </VBox>

            <VBox spacing="5.0">
                <Label text="Confirm Password" styleClass="field-label"/>
                <PasswordField fx:id="confirmPasswordField" promptText="Repeat your password"
                               styleClass="input-field" onAction="#handleRegister"/>
            </VBox>
        </VBox>

        <!-- Loading Spinner -->
        <ProgressIndicator fx:id="loadingSpinner" prefHeight="26.0" visible="false" managed="false"/>

        <!-- Action Button -->
        <Button fx:id="registerBtn" text="Create Account" styleClass="btn-primary"
                maxWidth="Infinity" onAction="#handleRegister"/>

        <Separator maxWidth="300.0" opacity="0.18"/>

        <HBox alignment="CENTER" spacing="7.0">
            <Label text="Already registered?" styleClass="text-muted"/>
            <Hyperlink text="Sign in" onAction="#handleBackToLogin" styleClass="source-link"/>
        </HBox>
    </VBox>
</StackPane>
