<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.sondhan.controller.HomeController"
            styleClass="root-pane" prefWidth="1140.0" prefHeight="800.0">

    <!-- ── TOP Header Bar ─────────────────────────────────────────────────── -->
    <top>
        <HBox styleClass="header" alignment="CENTER_LEFT" spacing="16.0">
            <padding><Insets top="13" right="22" bottom="13" left="22"/></padding>

            <!-- App Logo & Title -->
            <VBox spacing="1.0">
                <HBox spacing="9.0" alignment="CENTER_LEFT">
                    <Label text="Sondhan" styleClass="header-logo"/>
                    <Label text="v2.5" styleClass="header-badge"/>
                </HBox>
                <Label text="Multi-Source Fact Verification  ·  Newspapers  ·  Books  ·  Journals" styleClass="header-subtitle"/>
            </VBox>

            <Region HBox.hgrow="ALWAYS"/>

            <!-- Verification Engine Selector -->
            <HBox alignment="CENTER" spacing="10.0">
                <Label text="Engine:" styleClass="nav-label"/>
                <ComboBox fx:id="modelSelector" styleClass="model-combo" prefWidth="192.0"/>
            </HBox>

            <!-- API Status Pill -->
            <Label fx:id="apiKeyStatusLabel" text="Free Mode"
                   styleClass="badge-free-mode" onMouseClicked="#handleApiKeySettings"
                   style="-fx-cursor:hand;"/>

            <!-- Navigation Buttons -->
            <Button text="Theme" styleClass="nav-btn" onAction="#handleToggleTheme"/>
            <Button text="Settings" styleClass="nav-btn" onAction="#handleApiKeySettings"/>
            <Button text="History" styleClass="nav-btn" onAction="#handleHistory"/>

            <Separator orientation="VERTICAL" prefHeight="22.0" opacity="0.2"/>

            <!-- User Info -->
            <HBox alignment="CENTER" spacing="7.0" styleClass="user-badge-box">
                <Label fx:id="userNameLabel" text="User" styleClass="user-label"/>
            </HBox>

            <Button text="Sign Out" styleClass="nav-btn-ghost" onAction="#handleLogout"/>
        </HBox>
    </top>

    <!-- ── Center Workspace ──────────────────────────────────────────────── -->
    <center>
        <VBox spacing="16.0">
            <padding><Insets top="16" right="22" bottom="16" left="22"/></padding>

            <!-- ═══════════════════════════════════════════════════════════════
                 TOP SECTION: INPUT CONSOLE
                 ═══════════════════════════════════════════════════════════════ -->
            <VBox styleClass="panel" spacing="12.0">
                <padding><Insets top="16" right="20" bottom="16" left="20"/></padding>

                <!-- Input Tabs -->
                <TabPane fx:id="inputTabPane" styleClass="custom-tabpane">

                    <!-- Tab 1: Text Claim -->
                    <Tab fx:id="textTab" text="  Text Statement Verification  " closable="false">
                        <VBox spacing="12.0">
                            <padding><Insets top="12"/></padding>
                            <HBox spacing="14.0" alignment="CENTER_LEFT">
                                <TextArea fx:id="textInputArea"
                                          promptText="Enter a news headline, political claim, or factual statement to verify..."
                                          prefHeight="68.0" HBox.hgrow="ALWAYS" wrapText="true" styleClass="claim-textarea"/>
                                <Button fx:id="checkBtn" text="Verify Claim"
                                        styleClass="btn-primary" prefHeight="68.0" prefWidth="200.0"
                                        onAction="#handleCheck"/>
                            </HBox>

                            <!-- Quick Sample Chips -->
                            <HBox spacing="8.0" alignment="CENTER_LEFT">
                                <Label text="SAMPLE CLAIMS:" styleClass="section-label"/>
                                <FlowPane hgap="7.0" vgap="5.0" HBox.hgrow="ALWAYS" alignment="CENTER_LEFT">
                                    <Button text="Dhaka is capital since 1971" styleClass="preset-chip"
                                            onAction="#handleTextPresetDhaka"/>
                                    <Button text="5G causes cancer and radiation" styleClass="preset-chip"
                                            onAction="#handleTextPreset5G"/>
                                    <Button text="Eiffel Tower sold for scrap in 1925" styleClass="preset-chip"
                                            onAction="#handleTextPresetEiffel"/>
                                    <Button text="Apollo moon landing was staged" styleClass="preset-chip"
                                            onAction="#handleTextPresetMoon"/>
                                    <Button text="Climate change is a hoax" styleClass="preset-chip"
                                            onAction="#handleTextPresetClimate"/>
                                </FlowPane>
                            </HBox>
                        </VBox>
                    </Tab>

                    <!-- Tab 2: Image Verification -->
                    <Tab fx:id="imageTab" text="  Image Verification  " closable="false">
                        <VBox spacing="12.0">
                            <padding><Insets top="12"/></padding>

                            <HBox spacing="16.0" alignment="CENTER_LEFT">
                                <!-- Drop Zone -->
                                <StackPane fx:id="dropZone" styleClass="drop-zone"
                                           prefHeight="90.0" prefWidth="300.0" onMouseClicked="#handleBrowse">
                                    <VBox alignment="CENTER" spacing="5.0" fx:id="dropPromptBox">
                                        <Label text="Drop Image or Click to Browse" styleClass="drop-label"/>
                                        <Label text="PNG · JPG · WebP" styleClass="text-muted"/>
                                    </VBox>
                                    <ImageView fx:id="previewImage" visible="false"
                                               fitWidth="290.0" fitHeight="80.0" preserveRatio="true"/>
                                </StackPane>

                                <!-- Image Metadata Strip -->
                                <VBox fx:id="imageInfoBox" styleClass="image-inspect-card" spacing="5.0"
                                      HBox.hgrow="ALWAYS" visible="false" managed="false">
                                    <HBox alignment="CENTER_LEFT" spacing="8.0">
                                        <Label text="FILE:" styleClass="section-label"/>
                                        <Label fx:id="imageFileNameLabel" text="image.png" styleClass="text-bright" HBox.hgrow="ALWAYS"/>
                                        <Label fx:id="imageFormatLabel" text="PNG" styleClass="meta-pill"/>
                                        <Label fx:id="imageDimensionsLabel" text="800x600" styleClass="meta-pill"/>
                                        <Label fx:id="imageSizeLabel" text="150 KB" styleClass="meta-pill"/>
                                    </HBox>
                                    <HBox alignment="CENTER_LEFT" spacing="6.0">
                                        <Label text="SHA-256:" styleClass="section-label"/>
                                        <Label fx:id="imageHashLabel" text="a1b2c3..." styleClass="hash-pill" HBox.hgrow="ALWAYS"/>
                                    </HBox>
                                </VBox>

                                <!-- Image Action Buttons -->
                                <VBox spacing="6.0" alignment="CENTER">
                                    <Button text="Browse..." styleClass="btn-secondary" prefWidth="120.0" onAction="#handleBrowse"/>
                                    <Button fx:id="clearImageBtn" text="Clear" styleClass="btn-ghost"
                                            prefWidth="120.0" onAction="#handleClearImage" visible="false"/>
                                </VBox>

                                <Button fx:id="checkBtnImage" text="Verify Image"
                                        styleClass="btn-primary" prefHeight="80.0" prefWidth="200.0"
                                        onAction="#handleCheck"/>
                            </HBox>

                            <!-- Image Sample Chips -->
                            <HBox spacing="8.0" alignment="CENTER_LEFT">
                                <Label text="SAMPLE IMAGES:" styleClass="section-label"/>
                                <FlowPane hgap="7.0" vgap="5.0" HBox.hgrow="ALWAYS" alignment="CENTER_LEFT">
                                    <Button text="Dhaka Capital" styleClass="preset-chip" onAction="#handlePresetDhaka"/>
                                    <Button text="5G Health Claim" styleClass="preset-chip" onAction="#handlePreset5G"/>
                                    <Button text="Dr. Yunus Case" styleClass="preset-chip" onAction="#handlePresetYunus"/>
                                    <Button text="Mars Water Claim" styleClass="preset-chip" onAction="#handlePresetMars"/>
                                    <Button text="Eiffel Tower Scam" styleClass="preset-chip" onAction="#handlePresetEiffel"/>
                                </FlowPane>
                            </HBox>
                        </VBox>
                    </Tab>

                    <!-- Tab 3: URL Verification -->
                    <Tab fx:id="urlTab" text="  🔗 URL Verification  " closable="false">
                        <VBox spacing="12.0">
                            <padding><Insets top="12"/></padding>
                            <HBox spacing="14.0" alignment="CENTER_LEFT">
                                <TextField fx:id="urlInputField"
                                           promptText="Enter news article or social post URL to verify (e.g. https://...)"
                                           prefHeight="48.0" HBox.hgrow="ALWAYS" styleClass="claim-textarea"/>
                                <Button fx:id="checkBtnUrl" text="Verify URL"
                                        styleClass="btn-primary" prefHeight="48.0" prefWidth="200.0"
                                        onAction="#handleCheck"/>
                            </HBox>

                            <!-- Quick Sample URL Chips -->
                            <HBox spacing="8.0" alignment="CENTER_LEFT">
                                <Label text="SAMPLE URLS:" styleClass="section-label"/>
                                <FlowPane hgap="7.0" vgap="5.0" HBox.hgrow="ALWAYS" alignment="CENTER_LEFT">
                                    <Button text="5G Health Claim Article" styleClass="preset-chip"
                                            onAction="#handleUrlPreset5G"/>
                                    <Button text="Eiffel Tower Scrap Report" styleClass="preset-chip"
                                            onAction="#handleUrlPresetEiffel"/>
                                    <Button text="Climate Change Misinfo" styleClass="preset-chip"
                                            onAction="#handleUrlPresetClimate"/>
                                    <Button text="WHO Vaccine Safety Q&amp;A" styleClass="preset-chip"
                                            onAction="#handleUrlPresetWHO"/>
                                    <Button text="NASA Mars Water Page" styleClass="preset-chip"
                                            onAction="#handleUrlPresetMars"/>
                                </FlowPane>
                            </HBox>
                        </VBox>
                    </Tab>
                </TabPane>

                <!-- Progress Bar -->
                <VBox spacing="5.0" fx:id="loadingBox" visible="false" managed="false">
                    <HBox alignment="CENTER_LEFT" spacing="10.0">
                        <ProgressIndicator fx:id="loadingSpinner" prefHeight="18.0" prefWidth="18.0"/>
                        <Label fx:id="loadingLabel" text="Scanning and cross-referencing sources..."
                               styleClass="text-bright" style="-fx-font-weight:700;"/>
                    </HBox>
                    <ProgressBar fx:id="taskProgressBar" progress="-1.0" maxWidth="Infinity" styleClass="confidence-bar"/>
                </VBox>
            </VBox>

            <!-- ═══════════════════════════════════════════════════════════════
                 LOWER SECTION: RESULTS & VERIFIED SOURCES
                 ═══════════════════════════════════════════════════════════════ -->
            <ScrollPane HBox.hgrow="ALWAYS" VBox.vgrow="ALWAYS" fitToWidth="true" styleClass="result-scroll">
                <VBox spacing="16.0">

                    <!-- Welcome / Empty State -->
                    <VBox fx:id="emptyState" alignment="CENTER" spacing="18.0" prefHeight="400.0" styleClass="panel">
                        <padding><Insets top="40" right="40" bottom="40" left="40"/></padding>
                        <Label text="🔍" style="-fx-font-size:52px;"/>
                        <Label text="Ready to Verify" styleClass="panel-title" style="-fx-font-size:22px;"/>
                        <Label text="Enter a statement or select a sample claim above. Sondhan will cross-reference verified sources — newspapers, books, and academic journals — and show you all evidence below."
                               styleClass="panel-subtitle" wrapText="true" textAlignment="CENTER" maxWidth="520.0"/>
                    </VBox>

                    <!-- Result View -->
                    <VBox fx:id="resultPanel" spacing="16.0" visible="false" managed="false">

                        <!-- Verdict Row -->
                        <HBox styleClass="panel" spacing="22.0" alignment="CENTER_LEFT">
                            <padding><Insets top="18" right="22" bottom="18" left="22"/></padding>

                            <VBox spacing="5.0" alignment="CENTER_LEFT">
                                <Label text="VERDICT" styleClass="section-label"/>
                                <Label fx:id="verdictLabel" text="VERIFIED TRUE" styleClass="verdict-true"/>
                            </VBox>

                            <VBox spacing="7.0" HBox.hgrow="ALWAYS">
                                <HBox alignment="CENTER_LEFT" spacing="10.0">
                                    <Label text="CONFIDENCE INDEX" styleClass="section-label"/>
                                    <Region HBox.hgrow="ALWAYS"/>
                                    <Label fx:id="confidencePctLabel" text="98%" styleClass="confidence-pct"/>
                                </HBox>
                                <ProgressBar fx:id="confidenceBar" progress="0.98" maxWidth="Infinity" styleClass="confidence-bar"/>
                                <HBox spacing="8.0">
                                    <Label text="Source Coverage: High" styleClass="gauge-pill"/>
                                    <Label text="Cross-Indexed: Yes" styleClass="gauge-pill"/>
                                </HBox>
                            </VBox>

                            <Separator orientation="VERTICAL" prefHeight="60.0" opacity="0.2"/>

                            <VBox spacing="7.0" alignment="CENTER_RIGHT">
                                <Label fx:id="modelUsedBadge" text="Engine: Sondhan" styleClass="badge-ai-model"/>
                                <Label fx:id="preloadedBadge" text="Preloaded Fact" styleClass="badge-free-mode"/>
                            </VBox>
                        </HBox>

                        <!-- Side-by-Side Image Forensics Panel (Displayed when image is altered/out of context) -->
                        <VBox fx:id="imageComparisonPanel" styleClass="comparison-panel" spacing="12.0" visible="false" managed="false">
                            <HBox alignment="CENTER_LEFT" spacing="8.0">
                                <Label text="🔬 VISUAL FORENSICS: SUBMITTED VS. AUTHENTIC ORIGINAL" styleClass="section-label" style="-fx-text-fill: #34d399;"/>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Label fx:id="comparisonMatchLabel" text="Altered / Near-Duplicate Detected" styleClass="meta-pill" style="-fx-background-color: rgba(245, 158, 11, 0.2); -fx-text-fill: #fbbf24;"/>
                            </HBox>
                            <HBox spacing="16.0" alignment="CENTER">
                                <!-- Left: Submitted Image -->
                                <VBox spacing="6.0" alignment="CENTER" HBox.hgrow="ALWAYS" styleClass="comparison-column">
                                    <Label text="SUBMITTED / EXTRACTED IMAGE" styleClass="comparison-subhead" style="-fx-text-fill: #f87171;"/>
                                    <StackPane styleClass="comparison-image-box" prefHeight="170.0">
                                        <ImageView fx:id="submittedImageView" fitWidth="300.0" fitHeight="160.0" preserveRatio="true"/>
                                    </StackPane>
                                    <Label fx:id="submittedImageMetaLabel" text="Format: JPG · Dimensions: 800x600" styleClass="comparison-meta" wrapText="true"/>
                                </VBox>

                                <!-- Middle Divider -->
                                <VBox alignment="CENTER" spacing="4.0">
                                    <Label text="VS" styleClass="comparison-vs-badge"/>
                                </VBox>

                                <!-- Right: Original Authentic Image -->
                                <VBox spacing="6.0" alignment="CENTER" HBox.hgrow="ALWAYS" styleClass="comparison-column">
                                    <Label text="ORIGINAL ARCHIVED PHOTOGRAPH" styleClass="comparison-subhead" style="-fx-text-fill: #34d399;"/>
                                    <StackPane styleClass="comparison-image-box" prefHeight="170.0">
                                        <ImageView fx:id="originalImageView" fitWidth="300.0" fitHeight="160.0" preserveRatio="true"/>
                                    </StackPane>
                                    <Label fx:id="originalImageMetaLabel" text="Archived: June 2024 · Source: Official Records" styleClass="comparison-meta" wrapText="true"/>
                                </VBox>
                            </HBox>
                        </VBox>

                        <!-- Correction Card (Shown for FALSE / MISLEADING / MODIFIED) -->
                        <VBox fx:id="correctionCard" styleClass="correction-card" spacing="7.0" visible="false" managed="false">
                            <HBox alignment="CENTER_LEFT" spacing="8.0">
                                <Label text="💡 WHAT'S ACTUALLY TRUE (CORRECTION)" styleClass="correction-header"/>
                            </HBox>
                            <Label fx:id="correctionLabel" wrapText="true" styleClass="correction-text"/>
                        </VBox>

                        <!-- Analysis Card -->
                        <VBox styleClass="panel" spacing="14.0">
                            <padding><Insets top="18" right="22" bottom="18" left="22"/></padding>

                            <VBox styleClass="claim-card" spacing="5.0">
                                <HBox alignment="CENTER_LEFT" spacing="8.0">
                                    <Label text="EVALUATED STATEMENT" styleClass="section-label"/>
                                    <Region HBox.hgrow="ALWAYS"/>
                                    <Label fx:id="sourceUrlBadge" text="🔗 URL SOURCE" styleClass="meta-pill" visible="false" managed="false"/>
                                </HBox>
                                <Label fx:id="claimLabel" styleClass="claim-text" wrapText="true"/>
                                <Label fx:id="sourceUrlLabel" styleClass="text-muted" wrapText="true" visible="false" managed="false"/>
                            </VBox>

                            <VBox styleClass="explanation-card" spacing="7.0">
                                <Label text="FACTUAL ANALYSIS" styleClass="section-label"/>
                                <Label fx:id="explanationLabel" wrapText="true" styleClass="explanation-text"/>
                            </VBox>

                            <!-- 10-Point Summary -->
                            <VBox styleClass="summary-container" spacing="9.0" fx:id="summaryBox">
                                <HBox alignment="CENTER_LEFT" spacing="8.0">
                                    <Label text="10-POINT FACT SUMMARY" styleClass="section-label"/>
                                    <Region HBox.hgrow="ALWAYS"/>
                                    <Label fx:id="summaryStatusLabel" text="Generated" styleClass="text-muted"/>
                                </HBox>
                                <Label fx:id="summaryLabel" wrapText="true" styleClass="summary-item-text"/>
                            </VBox>
                        </VBox>

                        <!-- Sources Panel -->
                        <VBox styleClass="sources-container" spacing="14.0">
                            <HBox alignment="CENTER_LEFT" spacing="12.0">
                                <Label text="VERIFIED SOURCES  —  Click any source to open original article in browser"
                                       styleClass="section-label" style="-fx-font-size:12px;"/>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Label text="Opens in Safari" styleClass="text-muted"
                                       style="-fx-font-size:11.5px;-fx-font-weight:bold;"/>
                            </HBox>
                            <VBox fx:id="sourcesBox" spacing="10.0"/>
                        </VBox>

                        <!-- Article Analysis Result (Feature 3: Multi-Claim URL Verification) -->
                        <VBox fx:id="articleAnalysisCard" spacing="14.0" visible="false" managed="false">

                            <!-- Article Info Card -->
                            <VBox fx:id="articleInfoCard" styleClass="panel" spacing="10.0">
                                <padding><Insets top="16" right="20" bottom="16" left="20"/></padding>
                                <HBox alignment="CENTER_LEFT" spacing="8.0">
                                    <Label text="📰 ARTICLE" styleClass="section-label"/>
                                    <Region HBox.hgrow="ALWAYS"/>
                                    <Label fx:id="articlePublisherLabel" text="Publisher" styleClass="meta-pill"/>
                                    <Label fx:id="articleDateLabel" text="Date" styleClass="meta-pill"/>
                                </HBox>
                                <Label fx:id="articleTitleLabel" styleClass="claim-text" wrapText="true"/>
                            </VBox>

                            <!-- Detected Claims -->
                            <VBox styleClass="sources-container" spacing="10.0">
                                <HBox alignment="CENTER_LEFT" spacing="8.0">
                                    <Label text="🔍 DETECTED CLAIMS" styleClass="section-label"/>
                                    <Region HBox.hgrow="ALWAYS"/>
                                    <Label text="Click a claim to expand details" styleClass="text-muted"/>
                                </HBox>
                                <VBox fx:id="detectedClaimsBox" spacing="8.0"/>
                            </VBox>

                            <!-- Article Assessment -->
                            <VBox fx:id="articleAssessmentCard" styleClass="panel" spacing="10.0">
                                <padding><Insets top="16" right="20" bottom="16" left="20"/></padding>
                                <HBox alignment="CENTER_LEFT" spacing="8.0">
                                    <Label text="📊 ARTICLE ASSESSMENT" styleClass="section-label"/>
                                </HBox>
                                <Label fx:id="articleOverallVerdictLabel" styleClass="verdict-true" style="-fx-font-size:15px;"/>
                                <Label fx:id="articleOverallSummaryLabel" wrapText="true" styleClass="explanation-text"/>
                                <HBox fx:id="articleBreakdownBox" spacing="16.0"/>
                            </VBox>
                        </VBox>

                        <!-- Action Bar -->
                        <HBox alignment="CENTER_RIGHT" spacing="12.0">
                            <Button text="📋 Copy Report" styleClass="btn-secondary" onAction="#handleCopyReport"/>
                            <Button text="💾 Save Report (.md)" styleClass="btn-secondary" onAction="#handleExportReportFile"/>
                            <Button text="📤 Export JSON" styleClass="btn-secondary" onAction="#handleExportJson"/>
                            <Button text="Verify Another" styleClass="btn-primary" onAction="#handleResetView"/>
                        </HBox>

                    </VBox>
                </VBox>
            </ScrollPane>
        </VBox>
    </center>
</BorderPane>
