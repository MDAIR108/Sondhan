<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>

<StackPane xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.sondhan.controller.LoginController"
           styleClass="root-pane">

    <VBox styleClass="auth-card" maxWidth="440.0" alignment="CENTER" spacing="20.0">
        <padding><Insets top="42" right="48" bottom="42" left="48"/></padding>

        <!-- Brand Title -->
        <VBox alignment="CENTER" spacing="6.0">
            <Label text="Sondhan" styleClass="brand-logo-large"/>
            <Label text="Fact Verification Platform" styleClass="brand-subtitle-large"/>
            <Label text="Cross-reference claims across Newspapers, Books and Journals"
                   styleClass="text-muted" textAlignment="CENTER" wrapText="true"/>
        </VBox>

        <!-- Error Notification -->
        <Label fx:id="errorLabel" styleClass="error-label" wrapText="true" maxWidth="350.0"
               visible="false" managed="false"/>

        <!-- Form Inputs -->
        <VBox spacing="14.0" maxWidth="Infinity">
            <VBox spacing="5.0">
                <Label text="Email Address" styleClass="field-label"/>
                <TextField fx:id="emailField" promptText="name@example.com"
                           styleClass="input-field" onAction="#handleLogin"/>
            </VBox>

            <VBox spacing="5.0">
                <Label text="Password" styleClass="field-label"/>
                <PasswordField fx:id="passwordField" promptText="Enter your password"
                               styleClass="input-field" onAction="#handleLogin"/>
            </VBox>
        </VBox>

        <!-- Loading Spinner -->
        <ProgressIndicator fx:id="loadingSpinner" prefHeight="26.0" visible="false" managed="false"/>

        <!-- Action Buttons -->
        <VBox spacing="10.0" maxWidth="Infinity">
            <Button fx:id="loginBtn" text="Sign In" styleClass="btn-primary"
                    maxWidth="Infinity" onAction="#handleLogin"/>

            <Button text="Continue as Guest" styleClass="btn-secondary"
                    maxWidth="Infinity" onAction="#handleDemoLogin"/>
        </VBox>

        <Separator maxWidth="300.0" opacity="0.18"/>

        <!-- Register / Guest -->
        <VBox alignment="CENTER" spacing="9.0">
            <HBox alignment="CENTER" spacing="7.0">
                <Label text="No account?" styleClass="text-muted"/>
                <Hyperlink text="Create one" onAction="#handleRegister" styleClass="source-link"/>
            </HBox>

            <Hyperlink text="Guest access — no registration required"
                       onAction="#handleGuestMode" styleClass="source-link"
                       style="-fx-font-size:12px;"/>
        </VBox>
    </VBox>
</StackPane>
